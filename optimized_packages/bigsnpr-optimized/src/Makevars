# Prefer the bundled, optimized bigsparser header over LinkingTo headers.
PKG_CPPFLAGS = -Ivendor
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) -lz
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -DARMA_DONT_PRINT_OPENMP_WARNING -DARMA_DONT_PRINT_CXX11_WARNING -DARMA_64BIT_WORD=1
