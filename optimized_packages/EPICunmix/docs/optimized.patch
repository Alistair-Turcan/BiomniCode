@@ -104,9 +104,61 @@ bMIND = function(bulk, frac = NULL, sample_id = NULL, ncore = NULL, profile = NU
 
 # bmind with input of 2-dimensional data: X (gene x sample), W (sample x cell type); sample should be in the same order
 
+.epic_mcmc = local({
+  engine = NULL
+  function(...) {
+    if(!identical(as.character(utils::packageVersion("MCMCglmm")), "2.36"))
+      return(MCMCglmm(...))
+    if(is.null(engine)) {
+      original_build = get("buildZ", asNamespace("MCMCglmm"))
+      keys = list()
+      values = list()
+      memo_build = function(x, data, nginverse = NULL, covu = FALSE) {
+        variables = tryCatch(unique(c(all.vars(as.formula(paste("~", x))), "trait")),
+                             error = function(e) character())
+        eligible = is.data.frame(data) && length(variables) > 0L &&
+          all(variables %in% names(data))
+        if(eligible) eligible = all(vapply(data[,variables,drop=FALSE], function(v)
+          (is.numeric(v) || is.character(v) || is.factor(v) || is.logical(v)) &&
+          !anyNA(v), logical(1)))
+        if(!eligible) return(original_build(x, data, nginverse, covu))
+        key = serialize(list(x, data[,variables,drop=FALSE], nginverse, covu,
+                             getOption("contrasts"), getOption("na.action")), NULL)
+        hit = which(vapply(keys, identical, logical(1), y = key))
+        if(length(hit)) return(values[[hit[1L]]])
+        warned = FALSE
+        value = withCallingHandlers(original_build(x, data, nginverse, covu),
+                                    warning = function(w) warned <<- TRUE)
+        if(!warned) {
+          keys <<- c(list(key), head(keys, 3L))
+          values <<- c(list(value), head(values, 3L))
+        }
+        value
+      }
+      engine <<- MCMCglmm
+      env = new.env(parent = environment(MCMCglmm))
+      env$buildZ = memo_build
+      environment(engine) <<- env
+    }
+    engine(...)
+  }
+})
+
+.epic_make_cluster = function(ncore) {
+  # Fork only in conservative batch settings; retain isolated PSOCK otherwise.
+  can_fork = identical(Sys.info()[["sysname"]], "Linux") && !interactive() &&
+    is.numeric(ncore) && length(ncore) == 1L &&
+    identical(Sys.getenv("OPENBLAS_NUM_THREADS"), "1") &&
+    identical(Sys.getenv("OMP_NUM_THREADS"), "1") &&
+    identical(RNGkind(), c("Mersenne-Twister", "Inversion", "Rejection")) &&
+    identical(unname(getOption("contrasts")), c("contr.treatment", "contr.poly")) &&
+    identical(getOption("na.action"), "na.omit")
+  if(can_fork) parallel::makeForkCluster(ncore) else makeCluster(ncore)
+}
+
 bmind = function(X, W, sample_id, ncore = 30, profile = NULL, covariance = NULL, nu = 50, nitt = 1300, burnin = 300, thin = 1, V_fe = NULL, covariate = NULL, seed = 123) {
   
-  cl = makeCluster(ncore)
+  cl = .epic_make_cluster(ncore)
   registerDoParallel(cl)
   getDoParWorkers()
   
