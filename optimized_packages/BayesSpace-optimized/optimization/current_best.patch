+// Evaluate a single log density with an already computed covariance factor.
+static double density_log_diagonal_sum(const arma::mat &rooti) {
+  double even = 0.0, odd = 0.0;
+  arma::uword i = 0;
+  for (; i + 1 < rooti.n_rows; i += 2) {
+    even += std::log(rooti.at(i, i));
+    odd += std::log(rooti.at(i + 1, i + 1));
+  }
+  if (i < rooti.n_rows) even += std::log(rooti.at(i, i));
+  return even + odd;
+}
+
+static inline void density_tri_mult_seven(arma::rowvec &z, const arma::mat &rooti) {
+  double *x = z.memptr();
+  const double *r = rooti.memptr();
+  double t = 0.0;
+  t += r[0] * x[0];
+  t += r[7] * x[1];
+  t += r[14] * x[2];
+  t += r[21] * x[3];
+  t += r[28] * x[4];
+  t += r[35] * x[5];
+  t += r[42] * x[6];
+  x[0] = t;
+  t = 0.0;
+  t += r[8] * x[1];
+  t += r[15] * x[2];
+  t += r[22] * x[3];
+  t += r[29] * x[4];
+  t += r[36] * x[5];
+  t += r[43] * x[6];
+  x[1] = t;
+  t = 0.0;
+  t += r[16] * x[2];
+  t += r[23] * x[3];
+  t += r[30] * x[4];
+  t += r[37] * x[5];
+  t += r[44] * x[6];
+  x[2] = t;
+  t = 0.0;
+  t += r[24] * x[3];
+  t += r[31] * x[4];
+  t += r[38] * x[5];
+  t += r[45] * x[6];
+  x[3] = t;
+  t = 0.0;
+  t += r[32] * x[4];
+  t += r[39] * x[5];
+  t += r[46] * x[6];
+  x[4] = t;
+  t = 0.0;
+  t += r[40] * x[5];
+  t += r[47] * x[6];
+  x[5] = t;
+  t = 0.0;
+  t += r[48] * x[6];
+  x[6] = t;
+}
+
+double
+dmvnrm_log_precomputed(
+    const arma::subview_row<double> &x, const arma::subview_row<double> &mean,
+    const arma::mat &rooti, double other_terms, arma::rowvec &z
+) {
+  z = x - mean;
+  if (z.n_elem == 7 && rooti.n_rows == 7 && rooti.n_cols == 7) {
+    density_tri_mult_seven(z, rooti);
+    const double *p = z.memptr();
+    double even = 0.0, odd = 0.0;
+    even += p[0] * p[0];
+    odd += p[1] * p[1];
+    even += p[2] * p[2];
+    odd += p[3] * p[3];
+    even += p[4] * p[4];
+    odd += p[5] * p[5];
+    even += p[6] * p[6];
+    return other_terms - 0.5 * (even + odd);
+  } else {
+    inplace_tri_mat_mult_t(z, rooti);
+  }
+  return other_terms - 0.5 * arma::dot(z, z);
+}
+
+// Fixed-size version of Rcpp's weighted replacement sampler. Keep its
+// normalization order, R reverse-sort tie handling and uniform draw unchanged.
+int
+sample_two_labels(int previous, int proposed, double proposal_probability) {
+  double p[2] = {1 - proposal_probability, proposal_probability};
+  int permutation[2] = {1, 2};
+  double total = 0.0;
+  int positive = 0;
+  for (int i = 0; i < 2; ++i) {
+    if (!R_FINITE(p[i]) || p[i] < 0) {
+      stop("Probabilities must be finite and non-negative!");
+    }
+    positive += p[i] > 0.0;
+    total += p[i];
+  }
+  if (!positive) {
+    stop("Too few positive probabilities!");
+  }
+  for (int i = 0; i < 2; ++i) {
+    p[i] /= total;
+  }
+  Rf_revsort(p, permutation, 2);
+  p[1] += p[0];
+  const double uniform = unif_rand();
+  const int selected = (uniform <= p[0]) ? 0 : 1;
+  return permutation[selected] == 1 ? previous : proposed;
+}
